# Clé API Anthropic (https://platform.claude.com/). Sinon, `ant auth login` fonctionne aussi.
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé pour la lecture et l'optimisation des cartes.
OPTICARTE_MODEL=claude-opus-5-5

# Mettre à 1 pour tester l'interface sans appel API (carte fictive).
OPTICARTE_MOCK=0

# Dossier des données (base SQLite + photos). Par défaut ./data
# OPTICARTE_DATA_DIR=./data
